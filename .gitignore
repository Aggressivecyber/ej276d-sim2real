# Default to local-only. Add research source and compact results deliberately.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/PLAN.md
!/STATUS.md
!/PROGRAM.json
!/CURRENT_ROLE_INDEX.json
!/GOAL_REGISTRATION_RECEIPT.json
!/tasks/R*.md
!/work/R*/*.py
!/work/R*/config.json
!/work/R*/REPORT.md
!/work/R*/metrics.json
!/work/R*/ENVIRONMENT.json
!/work/R*/START.json
!/work/R*/RUN_HISTORY.json
!/work/R*/RESULT_RECEIPT.json
!/work/R*/FINAL_MANIFEST.json
!/work/R*/DELIVERY_CHECK.json
!/work/R*/MONITOR_REPAIR.json
!/work/R*/DELIVERY_QA.json
!/work/R*/FINAL_RECEIPT.json
!/work/R*/RESOURCE_RECEIPT.json
!/work/R*/INPUT_ACQUISITION.json
!/work/R*/PREPARATION_RECEIPT.json
!/work/R*/INITIAL_RNG.json
!/work/R*/REPLAY_CHECK.json
!/work/R*/METRICS_COMPACT.json
!/work/R*/results/FIXED_CONDITION_PAIRS.json
!/work/R*/source_run_*/*.py
!/work/R*/source_run_*/config.json
!/work/R*/results/C2ST_SPLITS.json
!/work/R*/results/DATA_ROLES.json
!/work/R*/results/INPUTS.json
!/work/R*/results/metrics.json
!/work/R*/results/TRAINING_RECEIPT.json
!/work/R*/results/TRAINING_TRACE.json
!/work/R*/results/figures/*.png
!/work/R*/run_*/NATIVE_RECEIPT.json
!/work/R*/run_*/results/metrics.json
!/work/R*/run_*/results/INPUT_MANIFEST.json
!/work/R*/run_*/results/C2ST_SPLITS.json
!/work/R*/run_*/results/figures/*.png

# Data, model weights, logs and all runtime caches remain on E:/D:.
**/.cache/
**/.runtime-cache/
**/runtime_cache/
**/__pycache__/
**/.venv/
**/node_modules/
*.npz
*.npy
*.bin
*.pickle
*.pkl
*.pt
*.pth
*.ckpt
*.safetensors
*.csv
*.log
*.zip
*.7z
*.tar
*.gz
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
